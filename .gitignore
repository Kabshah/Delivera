# ====================================================================
# Delivra — Git Ignore Configuration (single, repo-wide)
# Repo root = this file's folder. Patterns apply at every depth.
# ====================================================================

# --------------------------------------------------------------------
# Android / Gradle build artifacts (all regenerated by ./gradlew)
# --------------------------------------------------------------------
build/
.gradle/
.kotlin/
.externalNativeBuild/
.cxx/
local.properties

# Package / intermediate outputs
*.apk
*.aab
*.dex
*.class

# --------------------------------------------------------------------
# Android Studio / IntelliJ / VS Code
# --------------------------------------------------------------------
.idea/
*.iml
.navigation/
captures/
.vscode/

# --------------------------------------------------------------------
# Node.js runtime deps & WhatsApp (Baileys) session data
# NOTE: package.json / package-lock.json stay tracked.
# --------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/session/
**/sessions/

# --------------------------------------------------------------------
# Local Node.js toolchains (Windows runtimes used for `npm install`).
# ANCHORED on purpose: a bare `node/` here would also ignore
# app/src/main/cpp/include/node/ and break the native build!
# --------------------------------------------------------------------
/node18/
/node18.zip
/delivra/node/
/delivra/node.zip

# --------------------------------------------------------------------
# Signing keys / certificates — never commit secrets
#
# EXCEPTION: delivra/keystore/delivra-release.keystore IS committed on
# purpose. Android cannot install unsigned APKs, and updates must carry
# the same signature as the installed build — so the release key must be
# available to every CI run forever. For an open-source sideload-only app
# this public key is an accepted tradeoff (documented in
# app/build.gradle.kts); override via DELIVRA_STORE_FILE /
# DELIVRA_STORE_PASSWORD / DELIVRA_KEY_ALIAS / DELIVRA_KEY_PASSWORD env
# vars to sign privately instead.
# --------------------------------------------------------------------
*.jks
*.keystore
!delivra/keystore/delivra-release.keystore
*.p8
*.p12
*.pem
*.key

# --------------------------------------------------------------------
# Logs & misc
# --------------------------------------------------------------------
*.log

# --------------------------------------------------------------------
# OS generated files
# --------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
